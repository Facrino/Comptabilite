rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // --- Profiles ---
    match /profiles/{userId} {
      allow get: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidProfile(request.resource.data);
      allow delete: if false; // Profiles shouldn't be deleted by users usually

      function isValidProfile(data) {
        return data.keys().hasAll(['firstName', 'lastName', 'email', 'establishment', 'parcours', 'verified'])
          && data.firstName is string && data.firstName.size() <= 100
          && data.lastName is string && data.lastName.size() <= 100
          && data.email is string && data.email.size() <= 100
          && data.establishment is string && data.establishment.size() <= 200
          && data.parcours is string && data.parcours.size() <= 200
          && data.verified is bool;
      }
    }

    // --- Verification Codes ---
    match /verificationCodes/{userId} {
      allow get: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidCode(request.resource.data);
      allow delete: if isOwner(userId);

      function isValidCode(data) {
        return data.keys().hasAll(['code', 'userId', 'createdAt'])
          && data.code is string && data.code.size() == 4
          && data.userId == request.auth.uid
          && data.createdAt is timestamp;
      }
    }

    // --- Backups ---
    match /backups/{userId} {
      allow get: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidBackup(request.resource.data);
      allow delete: if isOwner(userId);

      function isValidBackup(data) {
        return data.keys().hasAll(['transactions', 'timestamp', 'userId'])
          && data.userId == request.auth.uid
          && data.transactions is list
          && data.timestamp is timestamp;
      }
    }

    // --- Transactions ---
    match /transactions/{txId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid && isValidTransaction(request.resource.data);
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid && isValidTransaction(request.resource.data);
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;

      function isValidTransaction(data) {
        return data.keys().hasAll(['id', 'date', 'label', 'lines', 'userId'])
          && data.userId == request.auth.uid
          && data.id is string
          && data.date is string
          && data.label is string
          && data.lines is list;
      }
    }
  }
}
