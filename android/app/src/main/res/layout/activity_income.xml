<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res/auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar_income"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:title="Compte de Résultat"
        android:background="#0F172A"
        app:titleTextColor="@color/white" />

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardCornerRadius="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- SIG Table Headers -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#F1F5F9"
                android:padding="12dp"
                android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_weight="1" android:text="POSTES" android:textSize="10sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:text="MONTANT N" android:textSize="10sp" android:textStyle="bold" />
            </LinearLayout>

            <!-- Row Production -->
            <LinearLayout
                android:id="@+id/layout_production_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageView
                    android:id="@+id/iv_prod_arrow"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginRight="8dp"
                    android:src="@android:drawable/arrow_down_float"
                    app:tint="@color/text_muted" />
                <TextView android:layout_width="0dp" android:layout_weight="1" android:text="Production de l'exercice" android:textColor="@color/text_main" />
                <TextView android:id="@+id/tv_val_production_total" android:layout_width="wrap_content" android:text="10 000 Ar" android:fontFamily="monospace" android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layout_production_details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingLeft="36dp"
                android:paddingRight="16dp"
                android:paddingBottom="12dp"
                android:visibility="gone"
                android:orientation="vertical">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <TextView android:layout_width="0dp" android:layout_weight="1" android:text="Ventes de marchandises" android:textSize="12sp" android:textColor="@color/text_muted"/>
                    <TextView android:id="@+id/tv_val_sales" android:layout_width="wrap_content" android:text="10 000 Ar" android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Row Consommation -->
            <LinearLayout
                android:id="@+id/layout_consommation_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageView
                    android:id="@+id/iv_cons_arrow"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginRight="8dp"
                    android:src="@android:drawable/arrow_down_float"
                    app:tint="@color/text_muted" />
                <TextView android:layout_width="0dp" android:layout_weight="1" android:text="Consommation de l'exercice" android:textColor="@color/text_main" />
                <TextView android:id="@+id/tv_val_consommation_total" android:layout_width="wrap_content" android:text="-50 000 Ar" android:fontFamily="monospace" android:textStyle="bold" android:textColor="@color/rose" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layout_consommation_details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingLeft="36dp"
                android:paddingRight="16dp"
                android:paddingBottom="12dp"
                android:visibility="gone"
                android:orientation="vertical">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <TextView android:layout_width="0dp" android:layout_weight="1" android:text="Achats consommés" android:textSize="12sp" android:textColor="@color/text_muted"/>
                    <TextView android:id="@+id/tv_val_purchases" android:layout_width="wrap_content" android:text="-50 000 Ar" android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Row VA -->
            <LinearLayout
                android:id="@+id/layout_va_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageView
                    android:id="@+id/iv_va_arrow"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginRight="8dp"
                    android:src="@android:drawable/arrow_down_float"
                    app:tint="@color/primary" />
                <TextView android:layout_width="0dp" android:layout_weight="1" android:text="Valeur Ajoutée (VA)" android:textStyle="bold" android:textColor="@color/primary" />
                <TextView android:id="@+id/tv_val_va" android:layout_width="wrap_content" android:text="-40 000 Ar" android:textStyle="bold" android:textColor="@color/rose" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layout_va_details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingLeft="36dp"
                android:paddingRight="16dp"
                android:paddingBottom="12dp"
                android:visibility="gone"
                android:orientation="vertical">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <TextView android:layout_width="0dp" android:layout_weight="1" android:text="Production de l'exercice" android:textSize="12sp" android:textColor="@color/text_muted"/>
                    <TextView android:id="@+id/tv_val_va_prod" android:layout_width="wrap_content" android:text="10 000 Ar" android:textSize="12sp" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="4dp">
                    <TextView android:layout_width="0dp" android:layout_weight="1" android:text="Consommation de l'exercice" android:textSize="12sp" android:textColor="@color/text_muted"/>
                    <TextView android:id="@+id/tv_val_va_cons" android:layout_width="wrap_content" android:text="-50 000 Ar" android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Row Personnel -->
            <LinearLayout
                android:id="@+id/layout_staff_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_weight="1" android:text="Charges de personnel" android:textColor="@color/text_main" />
                <TextView android:id="@+id/tv_val_staff" android:layout_width="wrap_content" android:text="-0 Ar" android:fontFamily="monospace" />
            </LinearLayout>

            <!-- Row EBE -->
            <LinearLayout
                android:id="@+id/layout_ebe_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageView
                    android:id="@+id/iv_ebe_arrow"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginRight="8dp"
                    android:src="@android:drawable/arrow_down_float"
                    app:tint="@color/text_muted" />
                <TextView android:layout_width="0dp" android:layout_weight="1" android:text="Excédent Brut d'Exploitation (EBE)" android:textStyle="bold" android:textColor="@color/text_main" />
                <TextView android:id="@+id/tv_val_ebe" android:layout_width="wrap_content" android:text="-40 000 Ar" android:textStyle="bold" android:textColor="@color/rose" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layout_ebe_details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingLeft="36dp"
                android:paddingRight="16dp"
                android:paddingBottom="12dp"
                android:visibility="gone"
                android:orientation="vertical">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <TextView android:layout_width="0dp" android:layout_weight="1" android:text="Valeur Ajoutée" android:textSize="12sp" android:textColor="@color/text_muted"/>
                    <TextView android:id="@+id/tv_val_ebe_va" android:layout_width="wrap_content" android:text="-40 000 Ar" android:textSize="12sp" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="4dp">
                    <TextView android:layout_width="0dp" android:layout_weight="1" android:text="Charges de personnel" android:textSize="12sp" android:textColor="@color/text_muted"/>
                    <TextView android:id="@+id/tv_val_ebe_staff" android:layout_width="wrap_content" android:text="-0 Ar" android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Row Operating Result -->
            <LinearLayout
                android:id="@+id/layout_operating_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageView
                    android:id="@+id/iv_operating_arrow"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginRight="8dp"
                    android:src="@android:drawable/arrow_down_float"
                    app:tint="@color/text_muted" />
                <TextView android:layout_width="0dp" android:layout_weight="1" android:text="Résultat d'Exploitation" android:textColor="@color/text_main" />
                <TextView android:id="@+id/tv_val_operating_total" android:layout_width="wrap_content" android:text="-40 000 Ar" android:fontFamily="monospace" android:textStyle="bold" android:textColor="@color/rose" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layout_operating_details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingLeft="36dp"
                android:paddingRight="16dp"
                android:paddingBottom="12dp"
                android:visibility="gone"
                android:orientation="vertical">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <TextView android:layout_width="0dp" android:layout_weight="1" android:text="Dotations amortissements" android:textSize="12sp" android:textColor="@color/text_muted"/>
                    <TextView android:id="@+id/tv_val_depreciation" android:layout_width="wrap_content" android:text="-0 Ar" android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Row Financial Result -->
            <LinearLayout
                android:id="@+id/layout_financial_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageView
                    android:id="@+id/iv_financial_arrow"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginRight="8dp"
                    android:src="@android:drawable/arrow_down_float"
                    app:tint="@color/text_muted" />
                <TextView android:layout_width="0dp" android:layout_weight="1" android:text="Résultat Financier" android:textColor="@color/text_main" />
                <TextView android:id="@+id/tv_val_financial_total" android:layout_width="wrap_content" android:text="0 Ar" android:fontFamily="monospace" android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layout_financial_details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingLeft="36dp"
                android:paddingRight="16dp"
                android:paddingBottom="12dp"
                android:visibility="gone"
                android:orientation="vertical">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <TextView android:layout_width="0dp" android:layout_weight="1" android:text="Produits financiers" android:textSize="12sp" android:textColor="@color/text_muted"/>
                    <TextView android:id="@+id/tv_val_fin_income" android:layout_width="wrap_content" android:text="0 Ar" android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Result Before Tax -->
            <LinearLayout
                android:id="@+id/layout_before_tax_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageView
                    android:id="@+id/iv_before_tax_arrow"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginRight="8dp"
                    android:src="@android:drawable/arrow_down_float"
                    app:tint="@color/text_muted" />
                <TextView android:layout_width="0dp" android:layout_weight="1" android:text="Résultat Avant Impôt" android:textColor="@color/text_main" />
                <TextView android:id="@+id/tv_val_before_tax" android:layout_width="wrap_content" android:text="-40 000 Ar" android:textStyle="bold" android:textColor="@color/rose" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layout_before_tax_details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingLeft="36dp"
                android:paddingRight="16dp"
                android:paddingBottom="12dp"
                android:visibility="gone"
                android:orientation="vertical">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <TextView android:layout_width="0dp" android:layout_weight="1" android:text="Résultat d'Exploitation" android:textSize="12sp" android:textColor="@color/text_muted"/>
                    <TextView android:id="@+id/tv_val_bt_operating" android:layout_width="wrap_content" android:text="-40 000 Ar" android:textSize="12sp" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="4dp">
                    <TextView android:layout_width="0dp" android:layout_weight="1" android:text="Résultat financier" android:textSize="12sp" android:textColor="@color/text_muted"/>
                    <TextView android:id="@+id/tv_val_bt_financial" android:layout_width="wrap_content" android:text="0 Ar" android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Row Exceptional Result -->
            <LinearLayout
                android:id="@+id/layout_exceptional_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageView
                    android:id="@+id/iv_exceptional_arrow"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginRight="8dp"
                    android:src="@android:drawable/arrow_down_float"
                    app:tint="@color/text_muted" />
                <TextView android:layout_width="0dp" android:layout_weight="1" android:text="Résultat Exceptionnel" android:textColor="@color/text_main" />
                <TextView android:id="@+id/tv_val_exceptional_total" android:layout_width="wrap_content" android:text="0 Ar" android:fontFamily="monospace" android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layout_exceptional_details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingLeft="36dp"
                android:paddingRight="16dp"
                android:paddingBottom="12dp"
                android:visibility="gone"
                android:orientation="vertical">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <TextView android:layout_width="0dp" android:layout_weight="1" android:text="Produits exceptionnels" android:textSize="12sp" android:textColor="@color/text_muted"/>
                    <TextView android:id="@+id/tv_val_ext_income" android:layout_width="wrap_content" android:text="0 Ar" android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>


            <!-- Final Result -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="20dp"
                android:background="@color/primary"
                android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_weight="1" android:text="RÉSULTAT NET" android:textColor="@color/white" android:textStyle="bold" />
                <TextView android:id="@+id/tv_val_net" android:layout_width="wrap_content" android:text="0 Ar" android:textColor="@color/white" android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>
