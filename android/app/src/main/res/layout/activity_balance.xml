<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar_balance"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:title="Bilan Patrimonial"
        android:background="#0F172A"
        app:titleTextColor="@color/white" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- ACTIF CARD -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#10B981"
                        android:padding="12dp"
                        android:text="ACTIF (EMPLOIS)"
                        android:textColor="@color/white"
                        android:textStyle="bold"/>
                    
                    <!-- Actif Immobilisé Header -->
                    <LinearLayout
                        android:id="@+id/layout_actif_immo_header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:padding="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <ImageView
                            android:id="@+id/iv_immo_arrow"
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:layout_marginRight="8dp"
                            android:src="@android:drawable/arrow_down_float"
                            app:tint="@color/text_muted" />
                        <TextView android:layout_width="0dp" android:layout_weight="1" android:text="ACTIF IMMOBILISÉ" android:textColor="@color/text_main" android:textSize="12sp" />
                        <TextView android:id="@+id/tv_val_immo_total" android:layout_width="wrap_content" android:text="2 500 000 Ar" android:textSize="12sp" android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Actif Immobilisé Details -->
                    <LinearLayout 
                        android:id="@+id/layout_actif_immo_details"
                        android:layout_width="match_parent" 
                        android:layout_height="wrap_content" 
                        android:orientation="vertical" 
                        android:paddingBottom="12dp"
                        android:paddingLeft="36dp"
                        android:paddingRight="16dp"
                        android:visibility="gone">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                            <TextView android:layout_width="0dp" android:layout_weight="1" android:text="Immobilisations corporelles" android:textSize="11sp" android:textColor="@color/text_muted"/>
                            <TextView android:id="@+id/tv_val_immo_corp" android:layout_width="wrap_content" android:text="2 500 000 Ar" android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Actif Circulant Header -->
                    <LinearLayout
                        android:id="@+id/layout_actif_circ_header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:padding="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <ImageView
                            android:id="@+id/iv_circ_arrow"
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:layout_marginRight="8dp"
                            android:src="@android:drawable/arrow_down_float"
                            app:tint="@color/text_muted" />
                        <TextView android:layout_width="0dp" android:layout_weight="1" android:text="ACTIF CIRCULANT" android:textColor="@color/text_main" android:textSize="12sp" />
                        <TextView android:id="@+id/tv_val_circ_total" android:layout_width="wrap_content" android:text="0 Ar" android:textSize="12sp" android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Actif Circulant Details -->
                    <LinearLayout 
                        android:id="@+id/layout_actif_circ_details"
                        android:layout_width="match_parent" 
                        android:layout_height="wrap_content" 
                        android:orientation="vertical" 
                        android:paddingBottom="12dp"
                        android:paddingLeft="36dp"
                        android:paddingRight="16dp"
                        android:visibility="gone">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                            <TextView android:layout_width="0dp" android:layout_weight="1" android:text="Stocks" android:textSize="11sp" android:textColor="@color/text_muted"/>
                            <TextView android:id="@+id/tv_val_stocks" android:layout_width="wrap_content" android:text="0 Ar" android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Disponibilités Header -->
                    <LinearLayout
                        android:id="@+id/layout_actif_treso_header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:padding="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <ImageView
                            android:id="@+id/iv_treso_actif_arrow"
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:layout_marginRight="8dp"
                            android:src="@android:drawable/arrow_down_float"
                            app:tint="@color/text_muted" />
                        <TextView android:layout_width="0dp" android:layout_weight="1" android:text="TRÉSORERIE ACTIF" android:textColor="@color/text_main" android:textSize="12sp" />
                        <TextView android:id="@+id/tv_val_treso_total" android:layout_width="wrap_content" android:text="10 000 Ar" android:textSize="12sp" android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout 
                        android:id="@+id/layout_actif_treso_details"
                        android:layout_width="match_parent" 
                        android:layout_height="wrap_content" 
                        android:orientation="vertical" 
                        android:paddingBottom="12dp"
                        android:paddingLeft="36dp"
                        android:paddingRight="16dp"
                        android:visibility="gone">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                            <TextView android:layout_width="0dp" android:layout_weight="1" android:text="Caisse" android:textSize="11sp" android:textColor="@color/text_muted"/>
                            <TextView android:id="@+id/tv_val_cash" android:layout_width="wrap_content" android:text="10 000 Ar" android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp"
                        android:orientation="horizontal"
                        android:background="#ECFDF5">
                        <TextView android:layout_width="0dp" android:layout_weight="1" android:text="TOTAL ACTIF" android:textStyle="bold" android:textColor="#065F46" />
                        <TextView android:id="@+id/tv_total_actif" android:layout_width="wrap_content" android:text="0 Ar" android:textStyle="bold" android:textColor="#065F46" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- PASSIF CARD -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#4F46E5"
                        android:padding="12dp"
                        android:text="PASSIF (RESSOURCES)"
                        android:textColor="@color/white"
                        android:textStyle="bold"/>
                    
                    <!-- Capitaux Propres Header -->
                    <LinearLayout
                        android:id="@+id/layout_passif_capitaux_header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:padding="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <ImageView
                            android:id="@+id/iv_capitaux_arrow"
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:layout_marginRight="8dp"
                            android:src="@android:drawable/arrow_down_float"
                            app:tint="@color/text_muted" />
                        <TextView android:layout_width="0dp" android:layout_weight="1" android:text="CAPITAUX PROPRES" android:textColor="@color/text_main" android:textSize="12sp" />
                        <TextView android:id="@+id/tv_val_capitaux_total" android:layout_width="wrap_content" android:text="-40 000 Ar" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/rose" />
                    </LinearLayout>

                    <!-- Capitaux Propres Details -->
                    <LinearLayout 
                        android:id="@+id/layout_passif_capitaux_details"
                        android:layout_width="match_parent" 
                        android:layout_height="wrap_content" 
                        android:orientation="vertical" 
                        android:paddingBottom="12dp"
                        android:paddingLeft="36dp"
                        android:paddingRight="16dp"
                        android:visibility="gone">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                            <TextView android:layout_width="0dp" android:layout_weight="1" android:text="Résultat de l'exercice" android:textSize="11sp" android:textColor="@color/text_muted"/>
                            <TextView android:id="@+id/tv_val_resultat" android:layout_width="wrap_content" android:text="-40 000 Ar" android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Dettes LT Header -->
                    <LinearLayout
                        android:id="@+id/layout_passif_lt_header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:padding="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <ImageView
                            android:id="@+id/iv_lt_arrow"
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:layout_marginRight="8dp"
                            android:src="@android:drawable/arrow_down_float"
                            app:tint="@color/text_muted" />
                        <TextView android:layout_width="0dp" android:layout_weight="1" android:text="DETTES À LONG TERME" android:textColor="@color/text_main" android:textSize="12sp" />
                        <TextView android:id="@+id/tv_val_lt_total" android:layout_width="wrap_content" android:text="0 Ar" android:textSize="12sp" android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout 
                        android:id="@+id/layout_passif_lt_details"
                        android:layout_width="match_parent" 
                        android:layout_height="wrap_content" 
                        android:orientation="vertical" 
                        android:paddingBottom="12dp"
                        android:paddingLeft="36dp"
                        android:paddingRight="16dp"
                        android:visibility="gone">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                            <TextView android:layout_width="0dp" android:layout_weight="1" android:text="Dettes financières" android:textSize="11sp" android:textColor="@color/text_muted"/>
                            <TextView android:id="@+id/tv_val_long_loans" android:layout_width="wrap_content" android:text="0 Ar" android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Dettes CT Header -->
                    <LinearLayout
                        android:id="@+id/layout_passif_ct_header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:padding="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <ImageView
                            android:id="@+id/iv_ct_arrow"
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:layout_marginRight="8dp"
                            android:src="@android:drawable/arrow_down_float"
                            app:tint="@color/text_muted" />
                        <TextView android:layout_width="0dp" android:layout_weight="1" android:text="DETTES À COURT TERME" android:textColor="@color/text_main" android:textSize="12sp" />
                        <TextView android:id="@+id/tv_val_ct_total" android:layout_width="wrap_content" android:text="2 550 000 Ar" android:textSize="12sp" android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout 
                        android:id="@+id/layout_passif_ct_details"
                        android:layout_width="match_parent" 
                        android:layout_height="wrap_content" 
                        android:orientation="vertical" 
                        android:paddingBottom="12dp"
                        android:paddingLeft="36dp"
                        android:paddingRight="16dp"
                        android:visibility="gone">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                            <TextView android:layout_width="0dp" android:layout_weight="1" android:text="Fournisseurs" android:textSize="11sp" android:textColor="@color/text_muted"/>
                            <TextView android:id="@+id/tv_val_provider_debts" android:layout_width="wrap_content" android:text="2 550 000 Ar" android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Trésorerie Passif Header -->
                    <LinearLayout
                        android:id="@+id/layout_passif_treso_header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:padding="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <ImageView
                            android:id="@+id/iv_treso_passif_arrow"
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:layout_marginRight="8dp"
                            android:src="@android:drawable/arrow_down_float"
                            app:tint="@color/text_muted" />
                        <TextView android:layout_width="0dp" android:layout_weight="1" android:text="TRÉSORERIE PASSIF" android:textColor="@color/text_main" android:textSize="12sp" />
                        <TextView android:id="@+id/tv_val_treso_passif_total" android:layout_width="wrap_content" android:text="0 Ar" android:textSize="12sp" android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout 
                        android:id="@+id/layout_passif_treso_details"
                        android:layout_width="match_parent" 
                        android:layout_height="wrap_content" 
                        android:orientation="vertical" 
                        android:paddingBottom="12dp"
                        android:paddingLeft="36dp"
                        android:paddingRight="16dp"
                        android:visibility="gone">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                            <TextView android:layout_width="0dp" android:layout_weight="1" android:text="Concours bancaires" android:textSize="11sp" android:textColor="@color/text_muted"/>
                            <TextView android:id="@+id/tv_val_overdraft" android:layout_width="wrap_content" android:text="0 Ar" android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp"
                        android:orientation="horizontal"
                        android:background="#EEF2FF">
                        <TextView android:layout_width="0dp" android:layout_weight="1" android:text="TOTAL PASSIF" android:textStyle="bold" android:textColor="#3730A3" />
                        <TextView android:id="@+id/tv_total_passif" android:layout_width="wrap_content" android:text="0 Ar" android:textStyle="bold" android:textColor="#3730A3" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
